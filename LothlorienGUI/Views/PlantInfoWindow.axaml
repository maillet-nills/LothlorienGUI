<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        Width="450" Height="600"
        CanResize="False"
        CanMaximize="False"
        WindowStartupLocation="CenterOwner"
        x:Class="LothlorienGUI.Views.PlantInfoWindow"
        Icon="/Assets/lothlorien-logo.ico"
        Title="🌿 Add a new plant"
        Background="{StaticResource BrushCanopy}">

    <Window.Styles>
        <Style Selector="RadioButton.ExposureOption">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="#F4F9EE"
                            BorderBrush="#D0E8B0"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            Width="60" Height="60"
                            BoxShadow="0 2 8 0 #14000000">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="RadioButton.ExposureOption:checked /template/ Border">
            <Setter Property="Background" Value="#E2F2C8"/>
            <Setter Property="BorderBrush" Value="#8DB33A"/>
            <Setter Property="BorderThickness" Value="2.5"/>
        </Style>

        <Style Selector="RadioButton.ExposureOption:pointerover /template/ Border">
            <Setter Property="Background" Value="#EBF5D8"/>
            <Setter Property="BorderBrush" Value="#AACF60"/>
        </Style>
        
        <Style Selector="NumericUpDown.Borderless">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="NumericUpDown.Borderless /template/ ButtonSpinner">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="NumericUpDown.Borderless /template/ ButtonSpinner /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource BrushParchment}"
            Margin="16"
            CornerRadius="16"
            BorderBrush="{StaticResource BrushCanopy}"
            BorderThickness="2"
            BoxShadow="0 6 24 0 #33000000">

        <Grid RowDefinitions="Auto,*,*,56">

            <!-- title -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="18,14,14,14"
                        Spacing="10"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <Border Background="{StaticResource BrushGoldenLight}"
                        CornerRadius="100"
                        Height="45" Width="45"
                        BoxShadow="0 2 10 0 #22000000">
                    <Image Source="/Assets/lothlorien-logo.png"
                           Width="34" Height="34"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Name="InfoTitleTextBlock"
                           FontWeight="Bold"
                           FontSize="16"
                           Foreground="{StaticResource BrushDeepForest}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Border Grid.Row="0"
                    Height="1" Background="#EEEEEE"
                    VerticalAlignment="Bottom" Margin="20,0"/>

            <!-- plant infos -->
            <StackPanel Grid.Row="1" Margin="20,14,20,10" Spacing="8">

                <TextBlock Text="Plant name/variety :" FontSize="13"/>
                <TextBox Name="PlantNameTextBox"
                         MaxLength="39"
                         IsEnabled="False"/>

                <TextBlock Text="Purchase date :" FontSize="13"/>
                <DatePicker Name="PlantDatePicker"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"/>

                <TextBlock Text="Placement :" FontSize="13"/>
                <ComboBox Name="PlantLocationComboBox"
                          IsEnabled="False"
                          PlaceholderText="Choose a location"
                          HorizontalAlignment="Stretch">
                    <ComboBoxItem>Living Room</ComboBoxItem>
                    <ComboBoxItem>Kitchen</ComboBoxItem>
                    <ComboBoxItem>Bedroom</ComboBoxItem>
                    <ComboBoxItem>Dining Room</ComboBoxItem>
                    <ComboBoxItem>Rest Room</ComboBoxItem>
                    <ComboBoxItem>Office</ComboBoxItem>
                    <ComboBoxItem>Balcony</ComboBoxItem>
                    <ComboBoxItem>Garden</ComboBoxItem>
                </ComboBox>

            </StackPanel>

            <Border Grid.Row="1"
                    Height="1" Background="#EEEEEE"
                    VerticalAlignment="Bottom" Margin="20,0"/>

             <!-- exposure & watering -->
            <StackPanel Grid.Row="2" Margin="20,14,20,10" Spacing="12" VerticalAlignment="Center">

                <!-- exposure -->
                <TextBlock Text="Exposure level :" FontSize="13"/>
                <Grid ColumnDefinitions="*,*,*">
                    <RadioButton Grid.Column="0"
                                 Classes="ExposureOption"
                                 GroupName="Exposure"
                                 Name="FullSunRadioButton"
                                 HorizontalAlignment="Center"
                                 IsHitTestVisible="False"
                                 ToolTip.Tip="Full sun">
                        <TextBlock Text="☀️" FontSize="20"/>
                    </RadioButton>
                    <RadioButton Grid.Column="1"
                                 Classes="ExposureOption"
                                 GroupName="Exposure"
                                 Name="PartialSunRadioButton"
                                 HorizontalAlignment="Center"
                                 IsHitTestVisible="False"
                                 ToolTip.Tip="Partial sun">
                        <TextBlock Text="🌤️" FontSize="20"/>
                    </RadioButton>
                    <RadioButton Grid.Column="2"
                                 Classes="ExposureOption"
                                 GroupName="Exposure"
                                 Name="LowSunRadioButton"
                                 HorizontalAlignment="Center"
                                 IsHitTestVisible="False"
                                 ToolTip.Tip="Low light">
                        <TextBlock Text="🌥️" FontSize="20"/>
                    </RadioButton>
                </Grid>

                <!-- watering frequency -->
                <TextBlock Text="Watering frequency :" FontSize="13"/>
                <Border Background="#F4F9EE"
                        BorderBrush="#D0E8B0"
                        BorderThickness="1.5"
                        CornerRadius="10"
                        Padding="14,10">
                    <Grid ColumnDefinitions="Auto,*,Auto">

                        <!-- icons -->
                        <Ellipse Grid.Column="0"
                                 Width="10" Height="10"
                                 Fill="DodgerBlue"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0"/>
                        
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock FontSize="11"
                                       Foreground="{StaticResource BrushStoneGray}"
                                       Text="Every"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Name="PlantWateringTextBlock" FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#3A5A2A"
                                           Text="{Binding #WateringFrequencyInput.Value, StringFormat='{}{0:0}'}"/>
                                <TextBlock FontSize="15"
                                           Foreground="#3A5A2A"
                                           Text="days"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <NumericUpDown Grid.Column="2"
                                       Classes="Borderless"
                                       Name="WateringFrequencyInput"
                                       IsHitTestVisible="False"
                                       Minimum="1" Maximum="90"
                                       Value="7" Increment="1"
                                       FormatString="0"
                                       Width="80"
                                       VerticalAlignment="Center"/>
                    </Grid>
                </Border>

            </StackPanel>

            <Border Grid.Row="2"
                    Height="1" Background="#EEEEEE"
                    VerticalAlignment="Bottom" Margin="20,0"/>

            <!-- edit button -->
            <StackPanel Grid.Row="3" Margin="20">
                <Button Content="Edit"
                        Name="EditPlantButton"
                        Click="EditPlantButton_OnClick"
                        Background="{StaticResource BrushCanopy}"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        Padding="20,10"
                        CornerRadius="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                
                <Button Content="Save"
                        IsVisible="False"
                        Name="SavePlantButton"
                        Click="SavePlantButton_OnClick"
                        Background="{StaticResource BrushCanopy}"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        Padding="20,10"
                        CornerRadius="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>